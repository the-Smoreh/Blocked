rules_version = '2';

// Security rules for the chat room.
//
// These are the only thing protecting the data. The config in
// src/firebase.js ships to every browser by design, so "nobody knows the
// key" is not a defence and was never meant to be one. Assume a stranger has
// the config, can sign in anonymously, and is sending whatever they like
// straight at the database with the browser console open. Everything below is
// written for that reader, not for our own client.
//
// Test them before trusting them:
//   npm.cmd run rules:test

service cloud.firestore {
  match /databases/{database}/documents {

    // The gap a sender has to leave between messages. Kept in step with
    // SEND_INTERVAL_MS in src/chat.js, where it drives the visible
    // countdown. This copy is the one that actually stops anyone.
    function gap() {
      return duration.value(2, 's');
    }

    function rateDoc(room, uid) {
      return /databases/$(database)/documents/rooms/$(room)/rate/$(uid);
    }

    // A message has exactly these four fields and nothing else. `hasOnly`
    // matters: without it, extra fields could be smuggled in, and anything
    // the client later trusted from a message would be attacker controlled.
    function validMessage(d) {
      return d.keys().hasOnly(['uid', 'user', 'text', 'at'])
        && d.keys().hasAll(['uid', 'user', 'text', 'at'])
        // You may only post as yourself. Without this, anyone could write
        // messages carrying someone else's uid.
        && d.uid == request.auth.uid
        && d.user is string && d.user.size() >= 1 && d.user.size() <= 18
        && d.text is string && d.text.size() >= 1 && d.text.size() <= 240
        // The server's own clock, not the sender's. A client supplied time
        // would let someone post into the past or the future and sit at the
        // top or bottom of the room forever.
        && d.at == request.time;
    }

    // Has this sender waited long enough? First message is always allowed.
    function offCooldown(room) {
      return !exists(rateDoc(room, request.auth.uid))
        || get(rateDoc(room, request.auth.uid)).data.last < request.time - gap();
    }

    // The rate marker must move forward in the same commit as the message.
    // `getAfter` inspects the state the batch is about to leave behind, which
    // is what makes the two writes inseparable: a message without the marker
    // update is refused, so nobody can post repeatedly while leaving their
    // marker stale.
    function marksSelf(room) {
      return getAfter(rateDoc(room, request.auth.uid)).data.last == request.time;
    }

    match /rooms/{room}/messages/{id} {
      // Signed in only. Anonymous counts, so this is not a real barrier, but
      // it means every read and write carries a uid the rules can reason
      // about.
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && validMessage(request.resource.data)
        && offCooldown(room)
        && marksSelf(room);

      // Nothing is editable or removable. Allowing deletes would let anyone
      // clear the room; allowing edits would let them rewrite what someone
      // else said. Pruning old messages is a job for an admin or a
      // scheduled function, not for visitors.
      allow update, delete: if false;
    }

    match /rooms/{room}/rate/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Only your own marker, only the one field, and only ever set to the
      // server's clock. Letting a sender choose the value would let them
      // write a time far in the past and never be limited again.
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last == request.time;

      allow delete: if false;
    }

    // ------------------------------------------------------ leaderboard
    //
    // One document per account, keyed by its uid, holding a running total of
    // seconds played. The config is public, so the question these rules
    // answer is: what stops someone typing a huge number into the console?
    //
    // Every write must be stamped with the server's clock, and may only add
    // as much time as has actually passed since the previous stamp, plus five
    // seconds of slack for the network. So the total can only ever grow at
    // the speed of a real clock. Two tabs cannot double it either: the second
    // one to write finds almost no time has passed since the first.
    //
    // And no single write may add more than 90 seconds. Without that cap,
    // someone could leave a gap of a day and then claim the whole day in one
    // write, since a day really had passed. The client flushes every minute,
    // so a normal write adds about 60 and sits comfortably under it.
    //
    // What this cannot stop is somebody leaving a book open and walking off.
    // That is time a book was really open, which is what is being counted.

    function validEntry(d) {
      return d.keys().hasOnly(['name', 'seconds', 'updated'])
        && d.keys().hasAll(['name', 'seconds', 'updated'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 18
        && d.seconds is int && d.seconds >= 0
        // The server's clock. A client supplied time would let someone widen
        // their own allowance by backdating the previous write.
        && d.updated == request.time;
    }

    function added() {
      return request.resource.data.seconds - resource.data.seconds;
    }

    match /leaderboard/{uid} {
      // Public. It is names and durations, the whole point is to show them,
      // and requiring a sign in just to look would be a network round trip
      // for nothing.
      allow read: if true;

      // Only your own row, and a first write can be at most one flush.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && validEntry(request.resource.data)
        && request.resource.data.seconds <= 90;

      allow update: if request.auth != null
        && request.auth.uid == uid
        && validEntry(request.resource.data)
        // Never backwards.
        && added() >= 0
        // Never more than one flush's worth.
        && added() <= 90
        // Never faster than the clock.
        && added() <= (request.time - resource.data.updated).seconds() + 5;

      // A row cannot be removed, by its owner or anyone else, or a bad week
      // could simply be deleted and started over.
      allow delete: if false;
    }

    // Everything else in the project is closed. Without this catch all, a
    // collection added later would default to whatever the last matching
    // rule happened to be.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
